{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "rootDir": "..",
        "paths": {
            "@getterdone/mcp-core": ["../mcp-core/src/index.ts", "./mcp-core/src/index.ts"],
            "@modelcontextprotocol/sdk/*": ["./node_modules/@modelcontextprotocol/sdk/dist/esm/*"],
            "zod/v4": ["./node_modules/zod/v4/index.d.ts"],
            "zod/v4/core": ["./node_modules/zod/v4/core/index.d.ts"]
        },
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}